---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const imageUrl = `${base}illustrations/mathbridge-school-and-home.png`;
const demoUrl = "https://mathbridge-ai-user-testing-kxnpfqdx5vvzhyzuvhrnmw.streamlit.app/?view=figure";
---

<section class="prototype" id="architecture-workflow" aria-labelledby="architecture-title">
  <header class="prototype-header">
    <h3 id="architecture-title">Student, teacher, and family views</h3>
    <a class="demo-link" href={demoUrl} target="_blank" rel="noopener noreferrer">
      Try the interactive figure <span aria-hidden="true">↗</span>
    </a>
  </header>
  <figure id="full-workflow">
    <a class="figure-link" href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label="Try the interactive MathBridge figure">
      <img
        src={imageUrl}
        alt="A student solves a unit-rate problem about scoring 48 points in six minutes. The teacher sees a follow-up lesson and the family sees how to practice the same skill at home."
        width="2400"
        height="3132"
        loading="lazy"
        decoding="async"
      />
    </a>
    <figcaption>
      <a href={imageUrl} target="_blank" rel="noopener noreferrer">View full-size image <span aria-hidden="true">↗</span></a>
    </figcaption>
  </figure>
</section>

<style>
  .prototype {
    padding-block: clamp(24px, 4vw, 48px);
    border-bottom: 1px solid var(--mb-line);
  }
  .prototype-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-bottom: 20px;
  }
  h3 {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--mb-ink);
  }
  .demo-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 8px;
    background: #204954;
    color: white;
    font-weight: 650;
    text-decoration: none;
  }
  .demo-link:hover { background: #173a49; }
  figure { margin: 0; }
  .figure-link {
    display: block;
    border: 1px solid var(--mb-line);
    border-radius: 12px;
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 10px;
    text-align: right;
  }
  figcaption a {
    color: var(--mb-ink);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: 3px solid #176d73;
    outline-offset: 3px;
  }
</style>
