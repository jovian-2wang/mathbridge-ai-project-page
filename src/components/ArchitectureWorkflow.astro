orkflow strong{font-weight:700}@media(max-width:760px){.full-workflow{padding:18px}.branch-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.diagnosis-chain{display:grid;grid-template-columns:1fr 1fr;gap:12px}.diagnosis-chain li+li:before{display:none}.diagnosis-chain{counter-reset:diagnosis}.diagnosis-chain li:before{counter-increment:diagnosis;content:counter(diagnosis) '. ';color:#806595}.diagnosis-chain li+li:before{display:inline;position:static;content:counter(diagnosis) '. ';font-size:16px}.flow-stage{padding:18px 14px}.edge span{font-size:13px}.architecture-workflow h4{font-size:21px}}@media(max-width:420px){.full-workflow{padding:12px}.branch-grid{gap:8px}.branch-grid article{padding:15px 10px}.branch-grid h5{font-size:17px}.branch-grid p{font-size:15px}.edge span{display:block;margin-top:4px}.diagnosis-stage{padding:16px}.flow-stage p{font-size:16px}}
</style>
