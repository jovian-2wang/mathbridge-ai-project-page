---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<header id="top" class="mb-academic-header full-bleed">
  <div class="mb-academic-nav mb-shell">
    <a class="mb-site-name" href="#top">MathBridge <span>AI</span></a>
    <nav aria-label="Page navigation">
      <a href="#abstract">Overview</a><a href="#demo">Live demo</a><a href="#learning">Learning example</a><a href="#research">Research</a>
    </nav>
  </div>
  <div class="mb-paper-head mb-shell">
    <div class="mb-paper-affiliations" aria-label="Research institutions">
      <a href="https://www.utsa.edu/" target="_blank" rel="noopener noreferrer"><img src={base + "brands/ut-san-antonio-logo.svg"} alt="UT San Antonio" width="344" height="48" /></a>
      <span aria-hidden="true"></span>
      <a href="https://www.ufl.edu/" target="_blank" rel="noopener noreferrer"><img src={base + "brands/uf-logo-full.png"} alt="University of Florida" width="367" height="68" /></a>
    </div>
    <p class="mb-paper-kicker">AN INTERACTIVE RESEARCH PROJECT PAGE</p>
    <h1>MathBridge AI</h1>
    <p class="mb-paper-subtitle">Student-aware support for learning mathematics</p>
    <p class="mb-paper-context">Grade 6 mathematics · Student, teacher, and family experiences · NSF award #2627693</p>
    <div class="mb-paper-links" aria-label="Project resources">
      <a href="#demo"><span aria-hidden="true">◉</span> Live demo</a>
      <a href="https://github.com/jovian-2wang/mathbridge-ai-project-page" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌘</span> Project code ↗</a>
      <a href="https://github.com/jovian-2wang/mathbridge-AI" target="_blank" rel="noopener noreferrer" title="Application repository is private"><span aria-hidden="true">⌘</span> App code <small>private</small> ↗</a>
      <a href="https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2627693" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span> NSF award</a>
    </div>
    <p class="mb-paper-source-note">The application repository is private. The public project page source is separate.</p>
  </div>
</header>
