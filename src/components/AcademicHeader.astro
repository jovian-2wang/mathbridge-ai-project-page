---
import { Icon } from "astro-icon/components";

type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
  icon?: string;
};

interface Props {
  title: string;
  teams: { name: string; members: Author[] }[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, teams, conference, notes, links } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-28",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        {/* Darken the cover so the white header text stays legible. */}
        <div class="absolute inset-0 bg-black/40" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      hasBackground
        ? "gap-10 text-white prose-headings:text-white [text-shadow:0_0_8px_rgba(0,0,0,0.6)]"
        : "gap-6",
    ]}
  >
    <h1 class="my-0 text-5xl font-medium">{title}</h1>
    <div class="project-teams">
      {teams.map((team) => (
        <section class="project-team" aria-label={team.name}>
          <h2>{team.name}</h2>
          <ul>
            {team.members.map((author) => (
              <li>
                {author.url ? <a href={author.url}>{author.name}</a> : author.name}
                {author.notes && author.notes.length > 0 && <sup>{author.notes.join(",")}</sup>}
                {author.institution && <div>{author.institution}</div>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {conference && <div>{conference}</div>}
    {
      notes && (
        <div class="text-center text-sm">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank" rel="noopener noreferrer"
              class:list={["flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline",
                hasBackground ? "bg-white hover:bg-zinc-200 text-zinc-800 text-shadow-none shadow-[0_0_8px_rgba(0,0,0,0.6)]" : "bg-zinc-800 text-white hover:bg-black dark:text-zinc-900 dark:hover:bg-zinc-50 dark:bg-zinc-200"
              ]}
            >
              {link.icon && <Icon name={link.icon} />}
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  .project-teams {
    display: grid;
    width: min(100%, 37rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 3rem;
    text-align: left;
  }
  .project-team h2 {
    margin: 0 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #c8d5d0;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .project-team ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-team li {
    font-size: 1.05rem;
    line-height: 1.55;
  }
  @media (max-width: 38rem) {
    .project-teams {
      grid-template-columns: 1fr;
      width: min(100%, 23rem);
    }
  }

  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: 0;
  }
</style>
