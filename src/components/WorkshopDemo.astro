---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const roles = ['student', 'teacher', 'parent'];
const scenes = [
  {heading:'3 books cost $6.',count:3,label:'$6 altogether',hint:'Each book costs the same.'},
  {heading:'How much for 1?',count:1,label:'$6 ÷ 3 = $2',hint:'One book costs $2.'},
  {heading:'Now count 5 books.',count:5,label:'5 × $2 = $10',hint:'Five books cost $10.'},
];
---
<section class="workshop-demo" id="demo" aria-labelledby="case-title">
  <header class="demo-heading"><h2 id="case-title">Let’s figure it out.</h2><p>One question. Three ways to help.</p></header>
  <div class="case-shell">
    <div class="role-tabs" role="group" aria-label="Choose a view">{roles.map((role,i)=><button type="button" data-case-role={role} aria-pressed={i===0} aria-controls={`case-${role}`}>{role==='student'?'For kids':role==='teacher'?'For teachers':'For families'}</button>)}</div>
    <div id="case-student" class="case-panel">
      <h3>3 books cost $6. How much for 5?</h3>
      <div class="step-buttons" role="group" aria-label="Steps in the example">{['Start with 3','Find 1','Try 5'].map((label,i)=><button type="button" data-step={i} aria-pressed={i===0} aria-controls={`book-scene-${i}`}><span>{i+1}</span>{label}</button>)}</div>
      <div class="animated-example" aria-live="polite" aria-atomic="true">{scenes.map((scene,i)=><div id={`book-scene-${i}`} data-scene={i} hidden={i!==0}>
        <p class="scene-title">{scene.heading}</p>
        <div class="books" aria-label={`${scene.count} ${scene.count===1?'book':'books'}`}>{Array.from({length:scene.count},(_,n)=><div class="book-group" style={`--delay:${n*130}ms`}><svg viewBox="0 0 72 94" aria-hidden="true"><rect x="5" y="3" width="60" height="82" rx="7" fill="#397861"/><path d="M16 3v72M17 77h47" fill="none" stroke="#bdd6aa" stroke-width="3"/><path d="M27 27h26M27 36h26M27 45h18" stroke="#f7f5dc" stroke-width="3" stroke-linecap="round"/><path d="M17 82h46" stroke="#fff9e8" stroke-width="5" stroke-linecap="round"/></svg>{i>0&&<span>$2</span>}</div>)}</div>
        <p class="math-line">{scene.label}</p><p class="scene-hint">{scene.hint}</p>
      </div>)}</div>
      <button type="button" class="next-button" data-next>Find the price of 1 →</button>
    </div>
    <div id="case-teacher" class="case-panel adult-panel" hidden>
      <h3>Find the tricky part.</h3>
      <div class="teacher-flow"><div class="speech student-speech"><span>Child says</span><p>“Two more books.<br />So I add $2?”</p></div><span class="flow-arrow" aria-hidden="true">→</span><div class="speech teacher-speech"><span>Teacher asks</span><p>“One book is $2.<br />How much for two?”</p></div></div>
      <p class="adult-hint">Help them count the cost of <strong>each</strong> book.</p>
    </div>
    <div id="case-parent" class="case-panel adult-panel" hidden>
      <h3>Try one together.</h3>
      <div class="family-example"><svg viewBox="0 0 160 95" aria-hidden="true"><path d="M10 82Q18 40 49 40t39 42" fill="#deba8f"/><circle cx="49" cy="23" r="18" fill="#a66d45"/><path d="M83 82q7-34 30-34t33 34" fill="#9aaf81"/><circle cx="114" cy="34" r="14" fill="#a66d45"/><path d="m58 69 24-7 25 7v23l-25-7-24 7Z" fill="#fffaf0" stroke="#305d4b" stroke-width="3"/><path d="M82 62v23" stroke="#305d4b" stroke-width="3"/></svg><p>“One book costs $2.<br />What would 4 books cost?”</p><p class="spanish" lang="es" hidden>“Un libro cuesta $2.<br />¿Cuánto costarían 4 libros?”</p></div>
      <button type="button" class="language-button" data-bilingual aria-pressed="false">English + Español</button>
      <details><summary>See the answer</summary><p>4 × $2 = $8. Ask: “How did you work it out?”</p><p class="spanish" lang="es" hidden>4 × $2 = $8. Pregúntale: “¿Cómo lo resolviste?”</p></details>
    </div>
    <p class="case-caption">Sample lesson · This shows a design idea, not a live AI chat.</p>
  </div>
  <div class="walkthroughs"><div class="recording-heading"><div><p class="eyebrow">See it in action</p><h3>Watch a video.</h3></div><p>Pick who you want to see.</p></div><div class="recording-tabs" role="group" aria-label="Choose a recorded walkthrough">{roles.map((role,i)=><button type="button" data-recording={role} aria-pressed={i===0} aria-controls={`recording-${role}`}>{role}<span>{i===0?'5:56':i===1?'2:05':'1:59'}</span></button>)}</div>{roles.map((role,i)=><div id={`recording-${role}`} data-recording-panel hidden={i!==0}><video controls playsinline preload="none" poster={`${base}videos/${role}-poster.png`} aria-label={`${role} walkthrough`}><source src={`${base}videos/${role}.mp4`} type="video/mp4" /><a href={`${base}videos/${role}.mp4`}>Download the {role} walkthrough</a></video></div>)}<p class="recording-note">Videos of the current tool · No spoken audio</p></div>
</section>
<script>
  const demo = document.querySelector('.workshop-demo');
  demo?.querySelectorAll<HTMLButtonElement>('[data-case-role]').forEach(button=>button.addEventListener('click',()=>{
    demo.querySelectorAll('[data-case-role]').forEach(tab=>tab.setAttribute('aria-pressed',String(tab===button)));
    demo.querySelectorAll<HTMLElement>('.case-panel').forEach(panel=>panel.hidden=panel.id!==`case-${button.dataset.caseRole}`);
  }));
  let step = 0;
  const stepButtons = demo?.querySelectorAll<HTMLButtonElement>('[data-step]');
  const next = demo?.querySelector<HTMLButtonElement>('[data-next]');
  function showStep(value: number) {
    step = value;
    stepButtons?.forEach(button=>button.setAttribute('aria-pressed',String(Number(button.dataset.step)===step)));
    demo?.querySelectorAll<HTMLElement>('[data-scene]').forEach(scene=>scene.hidden=Number(scene.dataset.scene)!==step);
    if(next) next.textContent=step===2?'Start again ↺':step===0?'Find the price of 1 →':'Now try 5 →';
  }
  stepButtons?.forEach(button=>button.addEventListener('click',()=>showStep(Number(button.dataset.step))));
  next?.addEventListener('click',()=>showStep((step+1)%3));
  const language = demo?.querySelector<HTMLButtonElement>('[data-bilingual]');
  language?.addEventListener('click',()=>{
    const enabled=language.getAttribute('aria-pressed')!=='true';
    language.setAttribute('aria-pressed',String(enabled));language.textContent=enabled?'English only':'English + Español';
    demo?.querySelectorAll<HTMLElement>('.spanish').forEach(p=>p.hidden=!enabled);
  });
  demo?.querySelectorAll<HTMLButtonElement>('[data-recording]').forEach(button=>button.addEventListener('click',()=>{
    demo.querySelectorAll('video').forEach(video=>video.pause());
    demo.querySelectorAll('[data-recording]').forEach(tab=>tab.setAttribute('aria-pressed',String(tab===button)));
    demo.querySelectorAll<HTMLElement>('[data-recording-panel]').forEach(panel=>panel.hidden=panel.id!==`recording-${button.dataset.recording}`);
  }));
</script>
<style>
.workshop-demo{width:min(1120px,calc(100% - 64px));margin:auto;font-family:Arial,Helvetica,sans-serif;color:#173e34;font-size:20px;line-height:1.5}.demo-heading{text-align:center;margin:0 auto 34px}.demo-heading h2{font:700 clamp(36px,4.5vw,54px)/1.15 Arial,Helvetica,sans-serif;letter-spacing:-.025em;color:#fff9ec}.demo-heading>p{font-size:23px;color:#f1f4e7;margin-top:14px}.case-shell{background:#fffdf7;border-radius:24px;overflow:hidden}.role-tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#e7ecdF}.role-tabs button{font:700 20px/1.3 Arial,Helvetica,sans-serif;padding:22px 12px;border:0;border-bottom:4px solid transparent;background:transparent;color:#38574a;cursor:pointer}.role-tabs button[aria-pressed=true]{background:#fffdf7;border-bottom-color:#236b50;color:#184e3c}.case-panel{padding:34px;text-align:center}.case-panel h3{font-size:clamp(26px,3vw,36px);line-height:1.3;font-weight:700;letter-spacing:-.025em}.case-panel[hidden],[data-scene][hidden],[data-recording-panel][hidden],.spanish[hidden]{display:none}.step-buttons{display:flex;justify-content:center;gap:12px;margin:25px 0}.step-buttons button{display:flex;align-items:center;gap:10px;border:1px solid #becdb8;border-radius:30px;background:#fffdf7;color:#345340;font:600 18px/1.3 Arial,Helvetica,sans-serif;padding:10px 18px;min-height:48px;cursor:pointer}.step-buttons button>span{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#e7ecdc;font-size:16px}.step-buttons button[aria-pressed=true]{background:#245e49;color:white;border-color:#245e49}.step-buttons button[aria-pressed=true]>span{background:#f2ecd5;color:#245e49}.animated-example{background:#eaf0df;border-radius:18px;padding:25px 20px 23px;min-height:320px;max-width:790px;margin:auto}.scene-title{font-size:24px;font-weight:600}.books{display:flex;justify-content:center;gap:20px;margin:20px 0 15px;min-height:116px;align-items:center}.book-group{width:72px;flex:0 1 72px;animation:book-in .5s both;animation-delay:var(--delay)}.book-group svg{display:block;width:100%;height:auto}.book-group>span{font-size:21px;font-weight:700;display:block}.math-line{font-size:clamp(30px,3.5vw,42px);font-weight:700;line-height:1.3}.scene-hint{font-size:20px;margin-top:6px}.next-button{background:#235f4a;color:#fffdf0;border:0;border-radius:12px;padding:15px 28px;font:700 20px/1.4 Arial,Helvetica,sans-serif;margin-top:24px;cursor:pointer;min-height:52px}.case-caption{text-align:center;border-top:1px solid #dbe2d4;padding:18px 22px;color:#55665b;font-size:16px}.adult-panel{padding:40px;min-height:480px}.teacher-flow{display:grid;grid-template-columns:1fr 50px 1fr;align-items:center;gap:15px;max-width:900px;margin:36px auto}.speech{border-radius:24px;padding:30px 20px;text-align:left;position:relative}.speech>span{font-size:18px;font-weight:600;display:block;margin-bottom:13px}.speech p{font-size:clamp(23px,2.6vw,30px);font-weight:600;line-height:1.4}.student-speech{background:#e9e5f2}.teacher-speech{background:#e6efdf}.flow-arrow{font-size:38px}.adult-hint{font-size:22px;margin-top:30px}.family-example{background:#f6e9d8;border-radius:20px;max-width:700px;margin:25px auto;padding:25px}.family-example svg{display:block;width:130px;height:90px;margin:0 auto 15px}.family-example>p{font-size:28px;line-height:1.4;font-weight:600}.family-example .spanish{font-size:22px;margin-top:18px;color:#69462a}.language-button{font:600 18px/1.4 Arial,Helvetica,sans-serif;border:1px solid #aebda5;border-radius:10px;background:white;padding:12px 20px;color:#245e49;cursor:pointer;min-height:48px}.language-button[aria-pressed=true]{background:#245e49;color:white}.adult-panel details{max-width:700px;margin:22px auto 0;font-size:20px}.adult-panel summary{cursor:pointer;font-weight:600}.adult-panel details p{margin-top:12px}.walkthroughs{margin-top:48px}.recording-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;color:#fff9ec;margin-bottom:22px}.eyebrow{font-size:18px;line-height:1.5;color:#e8d4a8}.recording-heading h3{font-size:36px;line-height:1.2;margin-top:8px;font-weight:700}.recording-heading>p{font-size:20px}.recording-tabs{display:flex;gap:12px;margin-bottom:20px}.recording-tabs button{border:1px solid #a5bfb1;background:transparent;color:#fff9ec;border-radius:30px;padding:12px 22px;font:600 20px/1.3 Arial,Helvetica,sans-serif;cursor:pointer;text-transform:capitalize}.recording-tabs button span{font-size:16px;margin-left:12px;font-weight:400}.recording-tabs button[aria-pressed=true]{background:#fff9ec;color:#235442;border-color:#fff9ec}.walkthroughs video{width:100%;aspect-ratio:16/9;display:block;border-radius:16px;background:#183b31}.recording-note{color:#eff3e7;font-size:16px;margin-top:16px;text-align:center}button:focus-visible,summary:focus-visible{outline:3px solid #be7434;outline-offset:5px}@keyframes book-in{from{opacity:0;transform:translateY(14px) scale(.9)}to{opacity:1;transform:translateY(0) scale(1)}}
@media(max-width:650px){.workshop-demo{width:calc(100% - 32px)}.demo-heading>p{font-size:20px}.role-tabs button{font-size:18px;padding:16px 8px}.case-panel{padding:26px 16px}.case-panel h3{font-size:28px}.step-buttons{gap:6px}.step-buttons button{font-size:16px;padding:10px 9px;gap:6px;flex:1;justify-content:center}.step-buttons button>span{display:none}.animated-example{padding:22px 12px;min-height:290px}.scene-title{font-size:22px}.books{gap:8px;min-height:113px}.book-group{max-width:60px}.book-group>span{font-size:18px}.scene-hint{font-size:18px}.next-button{font-size:18px;width:100%;padding:14px 12px}.case-caption{font-size:16px;text-align:left}.teacher-flow{grid-template-columns:1fr;gap:10px;margin:25px 0}.flow-arrow{transform:rotate(90deg);line-height:1}.speech{padding:23px}.speech p{font-size:26px}.adult-hint{font-size:20px}.family-example{padding:22px 14px}.family-example>p{font-size:24px}.recording-heading{display:block}.recording-heading>p{margin-top:12px}.recording-heading h3{font-size:32px}.recording-tabs{gap:7px}.recording-tabs button{font-size:17px;padding:12px 14px;flex:1}.recording-tabs button span{display:block;margin:4px 0 0;font-size:16px}.recording-note{font-size:16px}}@media(prefers-reduced-motion:reduce){.book-group{animation:none}}
</style>
