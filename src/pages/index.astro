---
import { Font } from "astro:assets";
import MathPlayground from "../components/MathPlayground.astro";
import RoleVideos from "../components/RoleVideos.astro";
import AcademicHeader from "../components/AcademicHeader.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const team = [
  ["Jiannan Cai", "1"], ["Emily Bonner", "1"], ["Claudia Cabrera", "1, 2"],
  ["Priscilla Rubio", "3"], ["Brenda Hinojosa-Bolaños", "3"],
  ["Shuai Li", "4"], ["Yuanyuan Lei", "4"], ["Jiangwei Wang", "4"],
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MathBridge AI: a student-aware platform connecting curriculum-grounded math learning, personalized support, and teacher and family insights." />
    <meta property="og:title" content="MathBridge AI | Connected and Contextualized Mathematics Support" />
    <meta property="og:description" content="Curriculum-grounded learning. Support that adapts to students. Insights that connect school and home." />
    <title>MathBridge AI | Connected Mathematics Support</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <Font cssVariable="--font-noto-sans" preload={[{ subset: "latin", style: "normal" }]} />
  </head>
  <body style={`--math-garden: url("${base}illustrations/math-garden.svg")`}>
    <header class="project-header" id="top">
      <nav class="role-login-nav wrap" aria-label="Platform login"><a class="role-brand" href="#top">MathBridge AI</a><div><a href="https://mathbridge-ai.duckdns.org/" target="_blank" rel="noopener noreferrer">Student login ↗</a><a href="https://mathbridge-ai.duckdns.org/" target="_blank" rel="noopener noreferrer">Teacher login ↗</a><a href="https://mathbridge-ai.duckdns.org/" target="_blank" rel="noopener noreferrer">Parent login ↗</a></div><small>One sign-in page. Use your student, teacher, or parent account.</small></nav>
      <div class="logo-row wrap" aria-label="Project institutions, school partners, and funder">
        <img class="utsa-logo" src={`${base}brands/ut-san-antonio-logo.svg`} alt="UT San Antonio" width="172" height="24" />
        <img class="uf-logo" src={`${base}brands/uf-workshop.png`} alt="University of Florida" width="367" height="205" />
        <img class="school-logo" src={`${base}brands/bonham-academy.png`} alt="Bonham Academy" width="100" height="100" />
        <img class="dual-logo" src={`${base}brands/dual-language-lab.png`} alt="1882 Dual Language Lab School — Lenguaje Dual Asociación 1882" width="280" height="80" />
        <img class="nsf-logo" src={`${base}brands/nsf-workshop.jpg`} alt="National Science Foundation" width="100" height="100" />
      </div>
      <div class="template-heading">
        <p class="kicker">MATHBRIDGE AI</p>
        <AcademicHeader
          title="A Student-Aware AI Platform for Connected and Contextualized K‑12 Mathematics Support"
          authors={team.map(([name, affiliations]) => ({ name, notes: affiliations.split(", ") }))}
          notes={[
            { symbol: "1", text: " UT San Antonio" },
            { symbol: "2", text: " 1882 Dual Language Lab School" },
            { symbol: "3", text: " Bonham Academy" },
            { symbol: "4", text: " University of Florida" },
          ]}
          links={[
            { name: "Try MathBridge AI", url: "https://mathbridge-ai.duckdns.org/", icon: "ri:external-link-line" },
            { name: "Code (private)", url: "https://github.com/jovian-2wang/mathbridge-AI", icon: "ri:github-fill" },
            { name: "NSF project", url: "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2627693", icon: "ri:article-line" },
          ]}
        />
      </div>
    </header>
    <main>
      <section class="overview wrap" id="overview">
        <div class="section-intro"><h2>Project Overview</h2></div>
        <div class="overview-copy"><p>MathBridge AI connects curriculum-grounded tutoring with an evolving picture of each student’s learning needs, misconceptions, and preferences. The research spans K‑12 mathematics, with a current Grade 6 prototype.</p><p>The platform design combines retrieval from instructional materials, coordinated AI agents, and learning memory. It makes mathematics relevant to students’ interests and turns learning interactions into actionable support for teachers and families.</p></div>
      </section>
      <figure class="overview-figure wrap" id="connected-learning" aria-labelledby="figure-title">
        <div class="figure-head"><span class="kicker">CONNECTED LEARNING</span><h3 id="figure-title">One learning journey. Shared understanding.</h3></div>
        <div class="knowledge-input"><div><span class="visual-label">CURRICULUM KNOWLEDGE</span><p>Textbooks · Teacher materials · Standards · Trusted resources</p></div><span class="retrieval-label">Retrieval-grounded support ↓</span></div>
        <div class="connection-map">
          <div class="map-person student"><span class="person-icon" aria-hidden="true">✎</span><h4>Student</h4><p>Ask. Reason. Practice.</p><span class="map-tag">Course + Free Math Help</span></div>
          <div class="map-connector"><span>Questions &amp; attempts</span><b aria-hidden="true">⇄</b><span>Guidance &amp; feedback</span></div>
          <div class="map-core"><span class="core-kicker">MATHBRIDGE AI</span><h4>Understand.<br />Reason.<br />Adapt.</h4><p>Question understanding<br />Reasoning · Student model</p></div>
          <div class="map-branches" aria-hidden="true"><span>Insights<br />&amp; suggestions</span><svg viewBox="0 0 100 240"><path d="M0 120 H35 V45 H92 M35 120 V195 H92"/><path d="M84 37 L92 45 L84 53 M84 187 L92 195 L84 203"/></svg></div>
          <div class="map-adults"><div class="map-person"><span class="role-label">IN THE CLASSROOM</span><h4>Teacher</h4><p>Understand gaps.<br />Plan teaching &amp; practice.</p></div><div class="map-person"><span class="role-label">AT HOME</span><h4>Parent</h4><p>See progress.<br />Know how to help.</p></div></div>
        </div>
        <div class="return-loop"><span aria-hidden="true">↶</span> Better support in class and at home <span aria-hidden="true">↵</span></div>
        <div class="platform-foundation"><div><strong>Learning memory</strong><span>Interactions · learner profiles · progress over time</span></div><div><strong>Privacy &amp; security by design</strong><span>Planned access controls · data protection · auditability</span></div></div>
        <figcaption>Platform design concept, redrawn from proposal Fig. 1. The prototype implements a focused subset of this architecture.</figcaption>
      </figure>
      <div class="video-garden"><span class="garden-orbit" aria-hidden="true"></span><RoleVideos /></div>

      <section class="features wrap" id="features">
        <div class="features-heading"><h2>Platform Features</h2></div>
        <article class="feature-row">
          <div class="feature-copy"><p class="module-label">01 / CURRICULUM</p><h3>Keep learning connected to class.</h3><p>Connect today’s Grade 6 concepts to official course tasks and instructional materials, or bring a question to Free Math Help. Vocabulary and skill checks help identify where support is needed.</p></div>
          <div class="curriculum-visual feature-visual"><div class="lesson-spine" aria-hidden="true"></div><span class="visual-label">TODAY’S MATH</span><h4>Ratios &amp; relationships</h4><div class="ratio-pair" aria-label="Two blue quantities and five yellow quantities"><span>● ●</span><span>● ● ● ● ●</span></div><p>Understand the quantities.<br />Explain the relationship.</p><div class="visual-footer">Official materials · Focused skills</div></div>
        </article>
        <article class="feature-row reverse">
          <div class="feature-copy"><p class="module-label">02 / LANGUAGE &amp; INTERESTS</p><h3>A familiar way into the mathematics.</h3><p>Learn in English or bilingual mode, listen to questions and hints, and choose up to three interests. Familiar contexts make the same mathematical idea easier to approach.</p></div>
          <MathPlayground />
        </article>
        <article class="feature-row">
          <div class="feature-copy"><p class="module-label">03 / HINT DESIGN</p><h3>Guide the thinking, one step at a time.</h3><p>A short explanation, a guiding question, or a useful visual helps students reason. When prerequisite knowledge is missing, targeted support and independent checks lead back to the Grade 6 goal.</p></div>
          <div class="hint-visual feature-visual"><span class="visual-label">SOCRATIC SUPPORT</span><p class="sample-hint">“A unit rate tells us the amount for one. Which quantity should become 1?”</p><div class="hint-path"><span>Explain</span><b>→</b><span>Try</span><b>→</b><span>Check</span></div><div class="grade-return"><span>Build foundations</span><strong>Grade 4 → Grade 5 → Grade 6</strong></div></div>
        </article>
        <div class="insight-pair">
          <article><p class="module-label">04 / TEACHER INSIGHTS</p><h3>See the gap.<br />Plan the next lesson.</h3><p>Turn saved learning evidence into what to teach, ask, and practice next. Find approved STAAR questions matched to the student’s recorded skill.</p><div class="insight-strip"><span>Teach next</span><span>Ask next</span><span>Matched practice</span></div></article>
          <article><p class="module-label">05 / PARENT SUMMARY</p><h3>Understand progress.<br />Help with confidence.</h3><p>See what your child has been learning and where support is needed. Get a question to ask, reasoning to listen for, and a short home-practice set with a separate answer key.</p><div class="insight-strip"><span>Recent learning</span><span>Home guidance</span><span>Focused practice</span></div></article>
        </div>
      </section>
      <section class="closing wrap colorful-closing"><p class="kicker">BUILT WITH EDUCATORS &amp; FAMILIES</p><h2>Connecting learning<br />across school and home.</h2><p>An early research prototype shaped through interdisciplinary co-design.</p></section>
    </main>
    <footer class="wrap"><strong>MathBridge AI</strong><p>Supported by the U.S. National Science Foundation · Award #2627693</p><small>Any opinions, findings, and conclusions or recommendations expressed in this material are those of the authors and do not necessarily reflect the views of the National Science Foundation.</small><small class="template-credit">Adapted from Roman Hauksson-Neill’s Academic Project Page Template · CC BY-SA 4.0. Layout modified for MathBridge AI.</small></footer>
  </body>
</html>
<style is:global>
  .role-login-nav {display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:18px 0;border-bottom:1px solid #d7e3e5}.role-login-nav a{text-decoration:none;font-size:12px;font-weight:600}.role-login-nav .role-brand{font-size:17px;color:#195b62}.role-login-nav>div{display:flex;gap:10px;flex-wrap:wrap}.role-login-nav>div a{padding:9px 15px;border:1px solid #c8d9d2;border-radius:24px}.role-login-nav>div a:hover{background:#edf5ef}.role-login-nav small{width:100%;text-align:right;color:#6b7f79;font-size:10px}@media(max-width:650px){.role-login-nav{justify-content:center}.role-login-nav>div{justify-content:center;gap:6px}.role-login-nav>div a{font-size:10px;padding:8px 10px}.role-login-nav small{text-align:center}}

  :root { color-scheme: light; --mb-ink: #173a49; --mb-muted: #546c76; --mb-teal: #176d73; --mb-line: #d7e3e5; }
  html { scroll-behavior: smooth; background: #fff; }
  body { margin: 0; font-family: var(--font-noto-sans), Arial, sans-serif; color: var(--mb-ink); background: #fff; }
  * { box-sizing: border-box; }
  main { margin: 0; }
  .wrap { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
  h1,h2,h3,h4,p { margin: 0; }
  a { color: inherit; }
  .kicker,.module-label,.visual-label,.role-label,.core-kicker { font-size: 11px; font-weight: 750; letter-spacing: .14em; line-height: 1.6; }
  .kicker { color: var(--mb-teal); }
  .logo-row { display: flex; align-items: center; justify-content: center; gap: 44px; padding: 28px 0; border-bottom: 1px solid var(--mb-line); min-height: 128px; }
  .logo-row img { object-fit: contain; height: auto; flex-shrink: 1; margin: 0; }
  .utsa-logo { width: 185px; filter: brightness(0) saturate(100%) invert(17%) sepia(20%) saturate(1489%) hue-rotate(154deg) brightness(92%) contrast(91%); }
  .logo-row .uf-logo { width: 176px; max-height: 80px; }
  .school-logo,.nsf-logo { width: 70px; }
  .dual-logo { width: 166px; }
  .project-title { text-align: center; padding: 55px 0 60px; }
  .project-title > .kicker { font-size: 17px; letter-spacing: .18em; margin-bottom: 18px; }
  h1 { max-width: 1000px; margin: auto; font-size: clamp(30px, 4.1vw, 52px); line-height: 1.16; letter-spacing: -.042em; font-weight: 650; }
  .team { margin: 30px auto 14px; display: flex; gap: 9px 22px; justify-content: center; flex-wrap: wrap; max-width: 900px; font-size: 15px; font-weight: 550; }
  sup { font-size: 9px; color: var(--mb-teal); margin-left: 3px; }
  .affiliations { display: flex; justify-content: center; gap: 8px 18px; flex-wrap: wrap; font-size: 12px; color: var(--mb-muted); }
  .project-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .project-links a { display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; border: 1px solid #bbced2; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 650; transition: transform .15s; }
  .project-links a:hover { transform: translateY(-2px); border-color: var(--mb-teal); }
  .project-links .primary { background: var(--mb-teal); color: white; border-color: var(--mb-teal); }
  .project-links small { font-size: 10px; font-weight: 400; }
  a:focus-visible { outline: 3px solid #c17746; outline-offset: 4px; }
  .overview { display: grid; grid-template-columns: 1fr 1fr; gap: 65px; padding: 64px 0 42px; border-top: 1px solid var(--mb-line); }
  h2 { font-size: clamp(27px, 3.2vw, 40px); line-height: 1.17; letter-spacing: -.035em; font-weight: 600; }
  .section-intro h2 { margin-top: 15px; }
  .overview-copy { color: var(--mb-muted); font-size: 15px; line-height: 1.8; }
  .overview-copy p + p { margin-top: 14px; }
  .overview-figure { background: #f0f6f5; border-radius: 14px; padding: 30px 34px 22px; }
  .figure-head h3 { font-size: 22px; font-weight: 550; letter-spacing: -.02em; margin-top: 5px; }
  .knowledge-input { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-block: 1px solid #ccddda; padding: 15px 0; margin-top: 24px; }
  .knowledge-input p { font-size: 12px; color: var(--mb-muted); margin-top: 4px; line-height: 1.6; }
  .retrieval-label { font-size: 11px; color: var(--mb-teal); white-space: nowrap; }
  .platform-foundation { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .platform-foundation > div { display: grid; gap: 6px; }
  .platform-foundation strong { font-size: 12px; font-weight: 600; }
  .platform-foundation span { font-size: 10px; color: var(--mb-muted); line-height: 1.6; }
  .connection-map { display: grid; grid-template-columns: 1.05fr .9fr 1.2fr .7fr 1.15fr; align-items: center; gap: 10px; margin-top: 30px; }
  .map-person { text-align: center; }
  .person-icon { display: grid; place-items: center; font-size: 36px; margin: 0 auto 12px; border: 1px solid #b5cdca; border-radius: 50%; width: 66px; height: 66px; }
  .map-person h4 { font-size: 21px; font-weight: 650; }
  .map-person p { font-size: 12px; line-height: 1.7; color: var(--mb-muted); margin-top: 6px; }
  .map-tag { display: inline-block; margin-top: 13px; font-size: 10px; color: var(--mb-teal); }
  .map-connector { display: grid; text-align: center; color: var(--mb-teal); font-size: 10px; gap: 2px; }
  .map-connector b { font-size: 40px; font-weight: 400; }
  .map-core { width: 210px; height: 210px; max-width: 100%; border-radius: 50%; background: #1c5960; color: white; display: flex; align-items: center; justify-content: center; flex-direction: column; margin: auto; box-shadow: 0 0 0 10px #dfebe8; text-align: center; }
  .core-kicker { font-size: 9px; color: #d3e8e3; }
  .map-core h4 { font-size: 25px; font-weight: 600; line-height: 1.15; margin: 8px 0; }
  .map-core p { font-size: 10px; line-height: 1.5; color: #d3e8e3; }
  .map-branches { position: relative; height: 240px; }
  .map-branches svg { width: 100%; height: 100%; fill: none; stroke: #759d9a; stroke-width: 1.5; }
  .map-branches > span { position: absolute; font-size: 10px; color: var(--mb-teal); top: 93px; left: 40%; padding-left: 7px; background: #f0f6f5; }
  .map-adults { display: grid; gap: 40px; }
  .role-label { font-size: 8px; color: var(--mb-teal); }
  .return-loop { width: 90%; margin: 24px auto 0; border-bottom: 1px solid #9ebeba; padding: 0 0 9px; text-align: center; font-size: 11px; color: #537c77; display: flex; justify-content: space-between; }
  .return-loop span { font-size: 20px; }
  figcaption { text-align: center; font-size: 11px; line-height: 1.7; color: var(--mb-muted); margin-top: 18px; }
  .features { padding-top: 85px; }
  .features-heading h2 { margin-top: 12px; }
  .feature-row { display: grid; grid-template-columns: 1fr 1fr; gap: 85px; align-items: center; padding: 52px 0; border-bottom: 1px solid var(--mb-line); }
  .feature-row.reverse .feature-copy { order: 2; }
  .module-label { color: #b16643; }
  .feature-copy h3,.insight-pair h3 { font-size: 31px; line-height: 1.2; letter-spacing: -.025em; font-weight: 600; margin: 14px 0; }
  .feature-copy p:last-child,.insight-pair article > p:not(.module-label) { font-size: 15px; line-height: 1.8; color: var(--mb-muted); }
  .feature-visual { min-height: 235px; border-radius: 10px; padding: 28px 34px; position: relative; overflow: hidden; }
  .visual-label { font-size: 9px; color: #4e756f; }
  .curriculum-visual { background: #f1f5ee; padding-left: 48px; }
  .lesson-spine { position: absolute; left: 14px; top: 0; bottom: 0; border-left: 2px solid #c0d0b8; }
  .curriculum-visual h4 { font-size: 23px; margin: 10px 0 13px; letter-spacing: -.02em; }
  .ratio-pair { display: flex; flex-wrap: wrap; gap: 16px; font-size: 23px; }
  .ratio-pair span:first-child { color: #3983a0; }
  .ratio-pair span:last-child { color: #c59539; }
  .feature-visual p { color: var(--mb-muted); font-size: 12px; line-height: 1.7; margin-top: 12px; }
  .visual-footer { font-size: 10px; margin-top: 18px; border-top: 1px solid #cfdbca; padding-top: 10px; color: #507148; }
  .language-visual { background: #eef3f8; }
  .language-lines { display: grid; gap: 9px; margin-top: 16px; }
  .language-lines strong { font-size: 19px; font-weight: 500; }
  .interest-line { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .interest-line span { padding: 4px 10px; border: 1px solid #c0d0db; border-radius: 20px; font-size: 10px; }
  .hint-visual { background: #fbf3ed; }
  .hint-visual .sample-hint { font-size: 18px; color: #704a34; line-height: 1.6; margin-top: 16px; }
  .hint-path { display: flex; gap: 15px; align-items: center; font-size: 11px; margin-top: 20px; color: #9b6447; }
  .hint-path b { font-weight: 400; }
  .grade-return { margin-top: 20px; border-top: 1px solid #e5cdbd; padding-top: 13px; display: grid; gap: 4px; font-size: 10px; color: #8d6148; }
  .grade-return strong { font-size: 13px; font-weight: 550; }
  .insight-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 85px; padding-top: 50px; }
  .insight-strip { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; font-size: 10px; color: var(--mb-teal); }
  .insight-strip span + span { border-left: 1px solid #b6cecb; padding-left: 12px; }
  .closing { margin-top: 75px; padding: 48px 0; border-top: 1px solid var(--mb-line); text-align: center; }
  .closing h2 { margin: 12px 0 15px; }
  .closing > p:last-child { color: var(--mb-muted); font-size: 13px; }
  footer { border-top: 1px solid var(--mb-line); padding-block: 25px 30px; display: grid; grid-template-columns: auto 1fr; gap: 12px 30px; align-items: center; }
  footer strong { font-size: 16px; } footer p { text-align: right; font-size: 11px; color: var(--mb-muted); }
  footer small { grid-column: 1/-1; font-size: 9px; line-height: 1.7; color: #74868b; }
  @media (max-width: 850px) {
    .logo-row { gap: 22px; flex-wrap: wrap; }
    .logo-row .utsa-logo { width: 150px; } .logo-row .uf-logo { width: 140px; }
    .dual-logo { width: 145px; } .school-logo,.nsf-logo { width: 55px; }
    .overview { gap: 30px; } .feature-row,.insight-pair { gap: 35px; }
    .connection-map { grid-template-columns: 1fr .6fr 1.2fr; gap: 12px; }
    .map-core { width: 200px; height: 200px; }
    .map-branches { display: none; }
    .map-adults { grid-column: 1/-1; display: flex; justify-content: space-around; margin-top: 25px; padding-top: 22px; border-top: 1px solid #b5cdca; }
  }
  @media (max-width: 560px) {
    .wrap { width: calc(100% - 36px); }
    .logo-row { gap: 18px 23px; padding-block: 20px; }
    .logo-row .utsa-logo { width: 133px; } .logo-row .uf-logo { width: 128px; }
    .logo-row .dual-logo { width: 118px; } .school-logo,.nsf-logo { width: 47px; }
    .project-title { padding-block: 35px 40px; }
    h1 { font-size: 31px; }
    .team { font-size: 12px; gap: 8px 14px; margin-top: 24px; }
    .affiliations { font-size: 10px; gap: 6px 12px; }
    .project-links { gap: 8px; } .project-links a { font-size: 11px; padding: 10px 12px; gap: 6px; }
    .overview { grid-template-columns: 1fr; gap: 20px; padding-top: 38px; }
    .overview-copy { font-size: 14px; }
    .overview-figure { padding: 22px 17px; }
    .figure-head h3 { font-size: 21px; }
    .knowledge-input { align-items: flex-start; flex-direction: column; gap: 10px; }
    .platform-foundation { grid-template-columns: 1fr; gap: 14px; }
    .connection-map { grid-template-columns: 1fr; gap: 15px; }
    .map-connector b { transform: rotate(90deg); height: 44px; }
    .map-core { width: 200px; height: 200px; }
    .map-adults { width: 100%; gap: 12px; } .map-person h4 { font-size: 19px; }
    .return-loop { width: 100%; font-size: 10px; align-items: center; gap: 8px; }
    .features { padding-top: 48px; }
    .feature-row { grid-template-columns: 1fr; gap: 22px; padding-block: 32px; }
    .feature-row.reverse .feature-copy { order: 0; }
    .feature-copy h3,.insight-pair h3 { font-size: 27px; }
    .feature-copy p:last-child,.insight-pair article > p:not(.module-label) { font-size: 14px; }
    .feature-visual { padding: 24px; } .curriculum-visual { padding-left: 36px; }
    .insight-pair { grid-template-columns: 1fr; gap: 35px; padding-top: 35px; }
    .closing { margin-top: 42px; }
    footer { grid-template-columns: 1fr; } footer p { text-align: left; } footer small { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .project-links a { transition: none; } }
</style>

<style is:global>
  /* Academic project layout based on the supplied upstream template. */
  .template-heading { padding: 48px 0 12px; }
  .template-heading > .kicker { text-align: center; margin-bottom: 20px; }
  .template-heading .full-bleed { margin-inline: 0; }
  .template-heading h1 { font-size: 48px; font-weight: 500; letter-spacing: -.035em; line-height: 1.14; }
