---
import { Font } from "astro:assets";
import DemoNavigator from "../components/DemoNavigator.astro";
import LearningLab from "../components/LearningLab.astro";
import "../styles/global.css";
import "../styles/mathbridge.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const live = "https://mathbridge-ai.duckdns.org/";
const projectRepo =
  "https://github.com/jovian-2wang/mathbridge-ai-project-page";
const appRepo = "https://github.com/jovian-2wang/mathbridge-AI";
const award = "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2627693";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MathBridge AI connects curriculum tasks, student responses, learning preferences, and evidence to support mathematics learning."
    />
    <meta
      property="og:title"
      content="MathBridge AI | Student-aware mathematics support"
    />
    <meta
      property="og:description"
      content="Interactive research project page and live MathBridge AI demonstration."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <title>MathBridge AI | Student-aware mathematics support</title>
  </head>

  <body class="site-page font-(family-name:--font-noto-sans)">
    <header id="top">
      <div class="topbar shell">
        <a class="brand" href="#top">MathBridge <b>AI</b></a>
        <nav aria-label="Page navigation">
          <a href="#why">Learning model</a><a href="#demo">Live demo</a><a
            href="#preferences">Preferences</a
          ><a href="#system">System design</a>
        </nav>
      </div>

      <div class="institution-band">
        <div class="institutions shell" aria-label="Research institutions">
          <div class="institution">
            <span>LEAD ORGANIZATION</span><a
              href="https://www.utsa.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={`${base}brands/ut-san-antonio-logo.svg`}
                alt="The University of Texas at San Antonio"
              /></a>
          </div>
          <i aria-hidden="true"></i>
          <div class="institution uf">
            <span>SUB-AWARDEE ORGANIZATION</span><a
              href="https://www.ufl.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={`${base}brands/uf-logo-full.png`}
                alt="University of Florida"
              /></a>
          </div>
          <a
            class="award-chip"
            href={award}
            target="_blank"
            rel="noopener noreferrer">NSF Award #2627693 ↗</a
          >
        </div>
      </div>

      <div class="hero shell">
        <div>
          <p class="eyebrow">INTERACTIVE RESEARCH PROJECT</p>
          <h1>MathBridge AI</h1>
          <p class="subtitle">Student-aware support for learning mathematics</p>
          <p class="lede">
            MathBridge AI helps a student make sense of the next mathematical
            step—not simply see whether an answer is right or wrong. It connects
            the assigned task, the student’s response, prior learning evidence,
            and the student’s preferred way of accessing an explanation. The
            mathematical goal stays fixed; the route into it can change.
          </p>
          <div class="links">
            <a class="primary" href="#demo">Explore the live demo</a><a
              href={live}
              target="_blank"
              rel="noopener noreferrer">Open platform ↗</a
            ><a href={projectRepo} target="_blank" rel="noopener noreferrer"
              >Project code ↗</a
            ><a href={award} target="_blank" rel="noopener noreferrer"
              >NSF award ↗</a>
          </div>
          <p class="repo-note">
            Application source: <a
              href={appRepo}
              target="_blank"
              rel="noopener noreferrer">private GitHub repository ↗</a>
          </p>
        </div>

        <aside class="profile-card">
          <p class="card-label">STUDENT LEARNING PROFILE</p>
          <h2>Preferences are part of the learning support.</h2>
          <dl>
            <div><dt>Language</dt><dd>English · 中文 · Español</dd></div><div>
              <dt>Interest context</dt><dd>Basketball · Baking · Games</dd>
            </div><div>
              <dt>Reading support</dt><dd>Listen to the prompt or hint</dd>
            </div>
          </dl>
          <div class="change">
            <b>WHAT CAN CHANGE</b><span
              >Wording, familiar context, and access mode.</span>
          </div>
          <div class="constant">
            <b>WHAT STAYS FIXED</b><span
              >Quantities, mathematical relationship, target skill, and expected
              reasoning.</span>
          </div>
        </aside>
      </div>
    </header>

    <main>
      <section id="why" class="section soft">
        <div class="shell">
          <div class="heading">
            <p class="eyebrow">
              01 / WHY THE STUDENT CAN LEARN MORE EFFECTIVELY
            </p><h2>
              Support follows the student’s thinking, then adapts how the next
              step is communicated.
            </h2><p>
              MathBridge does not replace the task with easier mathematics. It
              locates the obstacle in the current attempt, selects one useful
              move, and gives the student another chance to reason.
            </p>
          </div>
          <div class="learning-cycle">
            <article>
              <span>01</span><h3>Meet the real task</h3><p>
                The source prompt, quantities, and target micro-skill remain
                authoritative.
              </p>
            </article><i>→</i>
            <article>
              <span>02</span><h3>Reveal the current idea</h3><p>
                The response exposes a strategy, missing label, reversed order,
                or other obstacle.
              </p>
            </article><i>→</i>
            <article>
              <span>03</span><h3>Receive one next move</h3><p>
                A targeted hint, visual, or question supports reasoning without
                giving away the answer.
              </p>
            </article><i>→</i>
            <article>
              <span>04</span><h3>Try and transfer</h3><p>
                The student retries, then applies the same relationship to a
                similar problem.
              </p>
            </article>
          </div>
          <div class="preference-bridge">
            <div>
              <small>STUDENT PREFERENCE</small><strong
                >Language + interest + read-aloud</strong>
            </div><b aria-hidden="true">↳</b><p>
              Preferences reduce avoidable language and access barriers. They
              shape how the task and hint are presented; they do not change what
              counts as correct mathematics.
            </p>
          </div>
        </div>
      </section>

      <section id="demo" class="section">
        <div class="shell">
          <div class="split-heading">
            <div>
              <p class="eyebrow">02 / LIVE SYSTEM</p><h2>
                Open the working platform.
              </h2>
            </div><p>
              Choose Student, Teacher, or Parent for a guided path. The window
              below is the running MathBridge AI application—not a static
              screenshot.
            </p>
          </div><DemoNavigator /><p class="caption">
            <b>Live demo.</b> Role-specific access requires a matching test account.
            Use “Open full platform” if the embedded window is blocked.
          </p>
        </div>
      </section>

      <section id="preferences" class="section pale">
        <div class="shell">
          <div class="split-heading">
            <div>
              <p class="eyebrow">03 / INTERACTIVE LEARNING EXAMPLE</p><h2>
                Change the access path. Keep the mathematics.
              </h2>
            </div><p>
              Change the language, familiar context, or reading support. Then
              answer, request a clue, view a representation, and try a related
              task.
            </p>
          </div><LearningLab /><p class="caption">
            <b>Interactive illustration.</b> This browser example demonstrates the
            preference logic. Generated tutoring and saved evidence are available
            in the live platform.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <div class="heading">
            <p class="eyebrow">04 / ONE LEARNING RECORD, THREE PURPOSES</p><h2>
              Each role sees what it needs to support the next step.
            </h2>
          </div>
          <div class="roles">
            <article>
              <span>STUDENT</span><h3>Act on the next move</h3><ul>
                <li>Course Mode for assigned curriculum tasks</li><li>
                  Free Math Help for a student’s own question
                </li><li>
                  Hint ladder, approved visuals, retry, and similar problem
                </li><li>Saved language, interest, and reading preferences</li>
              </ul>
            </article>
            <article>
              <span>TEACHER</span><h3>Recognize a teachable pattern</h3><ul>
                <li>Recent attempts and evidence by student</li><li>
                  Micro-skill status and possible misconception signals
                </li><li>Student-level and class-level views</li><li>
                  A basis for deciding what to revisit next
                </li>
              </ul>
            </article>
            <article>
              <span>FAMILY</span><h3>Continue the conversation at home</h3><ul>
                <li>A readable summary of recent learning activity</li><li>
                  Questions to ask without revealing answers first
                </li><li>Short practice connected to the same skill</li><li>
                  Progress rather than a single score
                </li>
              </ul>
            </article>
          </div><p class="caption">
            These prototype views organize learning evidence. They do not claim
            measured learning gains.
          </p>
        </div>
      </section>

      <section id="system" class="section system">
        <div class="shell">
          <div class="heading">
            <p class="eyebrow">05 / SYSTEM DESIGN</p><h2>
              Curriculum support is prepared offline and retrieved only when
              needed.
            </h2><p>
              This follows the proposed workflow directly. Solid blue elements
              are part of the current curriculum or runtime. Dashed orange
              elements mark the proposed Answer Edition support extension.
            </p>
          </div>
          <div class="key">
            <span><i></i> Existing curriculum or runtime</span><span
              ><i class="proposed-line"></i> Proposed instructional support extension</span>
          </div>

          <div class="architecture">
            <section class="arch-panel">
              <header>
                <span>OFFLINE / COURSE DATA IMPORT</span><h3>
                  Prepare trustworthy support before students arrive.
                </h3>
              </header>
              <div class="offline-paths">
                <div class="path">
                  <div class="node">
                    <small>CURRICULUM SOURCE</small><strong
                      >Student Edition PDF</strong>
                  </div><b>↓</b><div class="node">
                    <strong>Source Task / Prompt / Task Spec</strong>
                  </div><b class="merge">↘</b>
                </div>
                <div class="path">
                  <div class="node proposed">
                    <small>SUPPORT SOURCE</small><strong
                      >Answer Edition PDF</strong>
                  </div><b class="orange">↓</b><div class="node proposed">
                    <strong>Generic Extractor</strong>
                  </div><b class="orange">↓</b><div class="node proposed">
                    <strong>Support Candidates</strong>
                  </div><b class="orange">↓</b><div class="node proposed">
                    <strong>Automatic Evaluator</strong><small
                      >RUNS ONLY DURING IMPORT</small>
                  </div><b class="merge orange">↙</b>
                </div>
              </div>
              <div class="database">
                <div class="db-head">
                  <span>SUPABASE</span><strong
                    >Structured curriculum and support</strong>
                </div><div class="db-records">
                  <div>
                    <small>EXISTING</small><code>curriculum_source_tasks</code
                    ><code>curriculum_micro_skills</code><code
                      >task–skill links</code
                    ><code>hints · evidence · visuals</code>
                  </div><div class="new">
                    <small>PROPOSED NEW</small><code
                      >curriculum_instructional_supports</code>
                  </div>
                </div>
              </div>
            </section>

            <section class="arch-panel">
              <header>
                <span>ONLINE / STUDENT RUNTIME</span><h3>
                  Use the student’s attempt to choose the next support.
                </h3>
              </header>
              <div class="runtime-start">
                <div class="node"><strong>Student</strong></div><b>↓</b><div
                  class="node"
                >
                  <strong>Course Task</strong>
                </div><b>↓</b><div class="node">
                  <strong>Student Response</strong>
                </div>
              </div>
              <div class="runtime-row">
                <aside>
                  <small>ACCESS PREFERENCES</small><strong>Language</strong
                  ><strong>Interest context</strong><strong>Read-aloud</strong
                  ><p>Shapes presentation—not the target skill.</p>
                </aside><b>→</b><div class="runtime-core">
                  <small>EXISTING RUNTIME</small><strong>Validator</strong><i
                    >↓</i
                  ><strong>Diagnosis</strong><i>↓</i><strong>Hint Agent</strong>
                </div>
              </div>
              <div class="lookup-arrow">
                ↓ <small>LOOK UP ONLY WHEN NEEDED</small>
              </div>
              <div class="support-db proposed">
                <small>INSTRUCTIONAL SUPPORT DB</small><div>
                  <strong>Task-specific support</strong><span>or</span><strong
                    >Micro-skill support</strong>
                </div>
              </div>
              <div class="lookup-arrow">↓</div>
              <div class="node output">
                <small>EXISTING HINT AGENT · SAME LLM CALL</small><strong
                  >Combine diagnosis, selected support, and student preference</strong>
              </div><div class="down">↓</div>
              <div class="student-hint">
                <strong>Student Hint</strong><span
                  >one useful next move → another attempt</span>
              </div>
            </section>
          </div>
          <p class="caption">
            <b>System status.</b> Validator, diagnosis, Hint Agent, curriculum tasks,
            micro-skills, hints, evidence, and visuals describe the current prototype.
            The Answer Edition extractor, automatic evaluator, instructional-support
            table, and conditional lookup are proposed extensions.
          </p>
        </div>
      </section>

      <section class="award section">
        <div class="shell award-grid">
          <div>
            <p class="eyebrow">RESEARCH CONTEXT</p><h2>NSF Award #2627693</h2><p
            >
              MathBridge AI is presented as an academic research prototype
              involving UT San Antonio and the University of Florida. The public
              NSF record provides the official award information.
            </p>
          </div><a href={award} target="_blank" rel="noopener noreferrer"
            >View the official award record ↗</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell">
        <strong>MathBridge AI</strong><span
          >Student-aware mathematics support</span
        ><a href={projectRepo} target="_blank" rel="noopener noreferrer"
          >GitHub project page ↗</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #142d3e;
    --muted: #536879;
    --blue: #155f74;
    --dark: #173c51;
    --orange: #b65736;
    --line: #d2dfe4;
    --pale: #f3f7f8;
  }
  html {
    scroll-behavior: smooth;
  }
  .site-page {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-noto-sans), Arial, sans-serif;
  }
  .site-page * {
    box-sizing: border-box;
  }
  .site-page :is(h1, h2, h3, p, dl, dd, ul) {
    margin-block-start: 0;
  }
  .site-page :is(a, button, input):focus-visible {
    outline: 3px solid #e6983e;
    outline-offset: 3px;
  }
  .shell {
    width: min(1160px, calc(100% - 3rem));
    margin-inline: auto;
  }
  .topbar {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    color: var(--ink) !important;
    font-weight: 900 !important;
    text-decoration: none !important;
  }
  .brand b {
    color: var(--orange);
  }
  .topbar nav {
    display: flex;
    gap: clamp(0.8rem, 2.5vw, 2rem);
  }
  .topbar nav a {
    color: #526574 !important;
    font-size: 0.78rem;
    font-weight: 700 !important;
    text-decoration: none !important;
  }
  .institution-band {
    background: var(--dark);
    color: #fff;
  }
  .institutions {
    min-height: 112px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .institution {
    display: grid;
    gap: 0.55rem;
  }
  .institution > span {
    color: #adc7d0;
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.14em;
  }
  .institution a {
    line-height: 0;
  }
  .institution img {
    display: block;
    width: auto;
    max-width: 225px;
    max-height: 45px;
    margin: 0;
    filter: brightness(0) invert(1);
  }
  .institution.uf img {
    max-width: 235px;
    max-height: 49px;
    filter: none;
  }
  .institutions > i {
    height: 58px;
    border-left: 1px solid #5b7887;
  }
  .award-chip {
    margin-left: auto;
    color: #fff !important;
    border: 1px solid #668493;
    padding: 0.7rem 0.9rem;
    font-size: 0.73rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(350px, 0.82fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding: 5.5rem 0;
  }
  .eyebrow {
    color: var(--orange);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin-bottom: 0.9rem;
  }
  .hero h1 {
    font-size: clamp(4.2rem, 8vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    font-weight: 780;
    margin: 0 0 1.2rem;
  }
  .subtitle {
    color: #27546a;
    font:
      400 clamp(1.25rem, 2.1vw, 1.75rem)/1.3 Georgia,
      serif;
  }
  .lede {
    color: #465f70;
    font-size: 1.02rem;
    line-height: 1.72;
    max-width: 730px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    color: var(--dark) !important;
    border: 1px solid #b7cad2;
    padding: 0.58rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .links a.primary {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff !important;
  }
  .repo-note {
    color: #72828d;
    font-size: 0.7rem;
    margin: 0.8rem 0 0;
  }
  .profile-card {
    border: 1px solid #b8ced6;
    background: #f5f9fa;
    box-shadow: 18px 18px 0 #e7eef0;
    padding: 1.6rem;
  }
  .card-label {
    color: var(--blue);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.13em;
  }
  .profile-card h2 {
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 1rem 0;
  }
  .profile-card dl > div {
    display: grid;
    grid-template-columns: 7.2rem 1fr;
    gap: 0.8rem;
    border-top: 1px solid #d6e2e5;
    padding: 0.62rem 0;
  }
  .profile-card dt {
    color: #687c88;
    font-size: 0.7rem;
  }
  .profile-card dd {
    color: #264b5d;
    font-size: 0.76rem;
    font-weight: 800;
  }
  .change,
  .constant {
    display: grid;
    border-left: 3px solid #78aebb;
    background: #fff;
    padding: 0.7rem 0.8rem;
    margin-top: 0.55rem;
  }
  .constant {
    border-left-color: var(--orange);
  }
  .change b,
  .constant b {
    color: #587987;
    font-size: 0.57rem;
    letter-spacing: 0.11em;
  }
  .change span,
  .constant span {
    color: #3f5a68;
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .section {
    padding: 5rem 0;
  }
  .soft {
    background: #f2f6f7;
  }
  .pale {
    background: #f7f9fa;
  }
  .heading {
    max-width: 890px;
    margin-bottom: 2rem;
  }
  .heading h2,
  .split-heading h2,
  .award h2 {
    font-size: clamp(2.3rem, 4vw, 3.7rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
    font-weight: 740;
    margin: 0 0 1rem;
  }
  .heading > p:last-child,
  .split-heading > p {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.68;
  }
  .split-heading {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .split-heading h2 {
    margin-bottom: 0;
  }
  .learning-cycle {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    align-items: stretch;
  }
  .learning-cycle article {
    border-top: 4px solid #79aebb;
    background: #fff;
    padding: 1.2rem;
  }
  .learning-cycle article:nth-of-type(2) {
    border-color: #c38262;
  }
  .learning-cycle article:nth-of-type(3) {
    border-color: #4f8b84;
  }
  .learning-cycle article:nth-of-type(4) {
    border-color: #547894;
  }
  .learning-cycle article > span,
  .roles article > span {
    color: var(--orange);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .learning-cycle h3 {
    font-size: 1rem;
    line-height: 1.25;
    margin: 0.55rem 0;
  }
  .learning-cycle p {
    color: #586c78;
    font-size: 0.74rem;
    line-height: 1.55;
    margin: 0;
  }
  .learning-cycle > i {
    display: grid;
    place-items: center;
    width: 30px;
    color: var(--orange);
    font-style: normal;
    font-size: 1.25rem;
  }
  .preference-bridge {
    display: grid;
    grid-template-columns: auto 45px 1fr;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.2rem;
    border: 1px solid #b9d2d8;
    background: #e9f2f4;
    padding: 1rem 1.2rem;
  }
  .preference-bridge > div {
    display: grid;
  }
  .preference-bridge small {
    color: var(--blue);
    font-size: 0.59rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .preference-bridge strong {
    font-size: 0.82rem;
  }
  .preference-bridge > b {
    color: var(--orange);
    font-size: 1.5rem;
    text-align: center;
  }
  .preference-bridge p {
    color: #46616e;
    font-size: 0.77rem;
    line-height: 1.52;
    margin: 0;
  }
  .caption {
    color: #697b88;
    font-size: 0.72rem;
    line-height: 1.5;
    margin: 1rem 0 0;
  }
  .caption b {
    color: #2c4655;
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }
