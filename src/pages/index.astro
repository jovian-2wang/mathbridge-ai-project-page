---
import { Font } from "astro:assets";
import RoleExperience from "../components/RoleExperience.astro";
import LearningCycle from "../components/LearningCycle.astro";
import InterestPicker from "../components/InterestPicker.astro";
import "../styles/global.css";
import "../styles/mathbridge.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const utsaLogo = "data:image/svg+xml;base64,";
const ufLogo = "data:image/png;base64,";
const live = "https://mathbridge-ai.duckdns.org/";
const projectRepo =
  "https://github.com/jovian-2wang/mathbridge-ai-project-page";
const appRepo = "https://github.com/jovian-2wang/mathbridge-AI";
const award = "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2627693";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MathBridge AI helps sixth graders learn mathematics through daily courses, their own questions, step-by-step hints, bilingual explanations, and read-aloud support."
    />
    <meta
      property="og:title"
      content="MathBridge AI | Math support for sixth graders"
    />
    <meta
      property="og:description"
      content="Interactive research project page and live MathBridge AI demonstration."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <title>MathBridge AI | Math support for sixth graders</title>
  </head>

  <body class="site-page font-(family-name:--font-noto-sans)">
    <header id="top">
      <div class="topbar shell">
        <a class="brand" href="#top">MathBridge <b>AI</b></a>
        <nav aria-label="Page navigation">
          <a href="#why">Student · Teacher · Parent</a><a href="#demo">Live demo</a><a
            href="#preferences">Preferences</a
          ><a href="#system">System design</a>
        </nav>
      </div>

      <div class="institution-band">
        <div class="institutions shell" aria-label="Research institutions">
          <div class="institution">
            <span>LEAD ORGANIZATION</span><a
              href="https://www.utsa.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={utsaLogo} width="344" height="48"
                alt="The University of Texas at San Antonio"
              /></a>
          </div>
          <i aria-hidden="true"></i>
          <div class="institution uf">
            <span>SUB-AWARDEE ORGANIZATION</span><a
              href="https://www.ufl.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={ufLogo} width="367" height="68"
                alt="University of Florida"
              /></a>
          </div>
          <a
            class="award-chip"
            href={award}
            target="_blank"
            rel="noopener noreferrer">NSF Award #2627693 ↗</a
          >
        </div>
      </div>

      <div class="hero shell">
        <div>
          <p class="eyebrow">INTERACTIVE RESEARCH PROJECT</p>
          <h1>MathBridge AI</h1>
          <p class="subtitle">Helping sixth graders learn mathematics</p>
          <p class="lede">
            MathBridge AI helps sixth graders understand mathematics, one step at a time.
            Students can learn today’s course or ask their own math questions,
            with guided hints, helpful visuals, bilingual explanations, and audio.
          </p>
          <div class="links" aria-label="Project resources">
            <a class="primary" href="#demo">Live demo</a>
            <a href={appRepo} target="_blank" rel="noopener noreferrer">Code (private) ↗</a>
            <a href={award} target="_blank" rel="noopener noreferrer">NSF award ↗</a>
            <a href={live} target="_blank" rel="noopener noreferrer">Open platform ↗</a>
          </div>
          <p class="repo-note">
            Application source: <a
              href={appRepo}
              target="_blank"
              rel="noopener noreferrer">private GitHub repository ↗</a>
          </p>
        </div>

        <aside class="profile-card">
          <p class="card-label">STUDENT LEARNING PROFILE</p>
          <h2>Learn in the language that helps you.</h2>
          <dl>
            <div><dt>Language</dt><dd>English · English + 中文 · English + Español</dd></div><div>
              <dt>Interests</dt><dd><InterestPicker /></dd>
            </div><div>
              <dt>Reading support</dt><dd>Click to hear the question or hint</dd>
            </div>
          </dl>
          <div class="change">
            <b>FREE MATH HELP</b><span>Ask any Grade 6 math question. Bring a problem, explore an idea, or ask about something you do not understand.</span>
          </div>
          <div class="constant">
            <b>COURSE MODE</b><span>Review what your teacher taught in class today. Work through explanations, guided practice, and independent checks to build a solid understanding of each classroom concept.</span>
          </div>
        </aside>
      </div>
    </header>

    <main>
      <RoleExperience />

      <section id="system" class="section system">
        <div class="shell">
          <div class="heading">
            <p class="eyebrow">02 / THE ADAPTIVE LEARNING CYCLE</p>
            <h2>Find the gap. Build understanding. Bring the student back.</h2>
            <p>MathBridge AI connects questions, diagnosis, targeted teaching, and independent checks
              in a continuous learning cycle. Support can reach back to Grade 5 or Grade 4 foundations,
              then move forward through each prerequisite to the original Grade 6 goal.</p>
          </div>
          <LearningCycle />
          <p class="caption"><b>Evidence guides the route.</b> A single incorrect answer does not establish a prerequisite gap.
            The mapped Grade 5 skill is checked first; Grade 4 is probed only when the Grade 5 independent check still fails.
            Passing a check shows evidence for that skill, not mastery of an entire grade.</p>
        </div>
      </section>

      <section class="award section">
        <div class="shell award-grid">
          <div>
            <p class="eyebrow">RESEARCH CONTEXT</p><h2>NSF Award #2627693</h2><p
            >
              MathBridge AI is presented as an academic research prototype
              involving UT San Antonio and the University of Florida. The public
              NSF record provides the official award information.
            </p>
          </div><a href={award} target="_blank" rel="noopener noreferrer"
            >View the official award record ↗</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell">
        <strong>MathBridge AI</strong><span
          >Math support for sixth graders</span
        ><a href={projectRepo} target="_blank" rel="noopener noreferrer"
          >GitHub project page ↗</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #142d3e;
    --muted: #536879;
    --blue: #155f74;
    --dark: #173c51;
    --orange: #b65736;
    --line: #d2dfe4;
    --pale: #f3f7f8;
  }
  html {
    scroll-behavior: smooth;
  }
  .site-page {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-noto-sans), Arial, sans-serif;
  }
  .site-page * {
    box-sizing: border-box;
  }
  .site-page :is(h1, h2, h3, p, dl, dd, ul) {
    margin-block-start: 0;
  }
  .site-page :is(a, button, input):focus-visible {
    outline: 3px solid #e6983e;
    outline-offset: 3px;
  }
  .shell {
    width: min(1160px, calc(100% - 3rem));
    margin-inline: auto;
  }
  .topbar {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    color: var(--ink) !important;
    font-weight: 900 !important;
    text-decoration: none !important;
  }
  .brand b {
    color: var(--orange);
  }
  .topbar nav {
    display: flex;
    gap: clamp(0.8rem, 2.5vw, 2rem);
  }
  .topbar nav a {
    color: #526574 !important;
    font-size: 0.78rem;
    font-weight: 700 !important;
    text-decoration: none !important;
  }
  .institution-band {
    background: var(--dark);
    color: #fff;
  }
  .institutions {
    min-height: 112px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .institution {
    display: grid;
    gap: 0.55rem;
  }
  .institution > span {
    color: #adc7d0;
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.14em;
  }
  .institution a {
    line-height: 0;
  }
  .institution img {
    display: block;
    width: auto;
    max-width: 225px;
    height: auto;
    max-height: 45px;
    object-fit: contain;
    margin: 0;
    filter: brightness(0) invert(1);
  }
  .institution.uf img {
    max-width: 235px;
    max-height: 49px;
    filter: none;
  }
  .institutions > i {
    height: 58px;
    border-left: 1px solid #5b7887;
  }
  .award-chip {
    margin-left: auto;
    color: #fff !important;
    border: 1px solid #668493;
    padding: 0.7rem 0.9rem;
    font-size: 0.73rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(350px, 0.82fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding: 5.5rem 0;
  }
  .eyebrow {
    color: var(--orange);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin-bottom: 0.9rem;
  }
  .hero h1 {
    font-size: clamp(4.2rem, 8vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
    font-weight: 780;
    margin: 0 0 1.2rem;
  }
  .subtitle {
    color: #27546a;
    font:
      400 clamp(1.25rem, 2.1vw, 1.75rem)/1.3 Georgia,
      serif;
  }
  .lede {
    color: #465f70;
    font-size: 1.02rem;
    line-height: 1.72;
    max-width: 730px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    color: var(--dark) !important;
    border: 1px solid #b7cad2;
    padding: 0.58rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .links a.primary {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff !important;
  }
  .repo-note {
    color: #72828d;
    font-size: 0.7rem;
    margin: 0.8rem 0 0;
  }
  .profile-card {
    border: 1px solid #b8ced6;
    background: #f5f9fa;
    box-shadow: 18px 18px 0 #e7eef0;
    padding: 1.6rem;
  }
  .card-label {
    color: var(--blue);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.13em;
  }
  .profile-card h2 {
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 1rem 0;
  }
  .profile-card dl > div {
    display: grid;
    grid-template-columns: 7.2rem 1fr;
    gap: 0.8rem;
    border-top: 1px solid #d6e2e5;
    padding: 0.62rem 0;
  }
  .profile-card dt {
    color: #687c88;
    font-size: 0.7rem;
  }
  .profile-card dd {
    color: #264b5d;
    font-size: 0.76rem;
    font-weight: 800;
  }
  .change,
  .constant {
    display: grid;
    border-left: 3px solid #78aebb;
    background: #fff;
    padding: 0.7rem 0.8rem;
    margin-top: 0.55rem;
  }
  .constant {
    border-left-color: var(--orange);
  }
  .change b,
  .constant b {
    color: #587987;
    font-size: 0.57rem;
    letter-spacing: 0.11em;
  }
  .change span,
  .constant span {
    color: #3f5a68;
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .section {
    padding: 5rem 0;
  }
  .soft {
    background: #f2f6f7;
  }
  .pale {
    background: #f7f9fa;
  }
  .heading {
    max-width: 890px;
    margin-bottom: 2rem;
  }
  .heading h2,
  .split-heading h2,
  .award h2 {
    font-size: clamp(2.3rem, 4vw, 3.7rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
    font-weight: 740;
    margin: 0 0 1rem;
  }
  .heading > p:last-child,
  .split-heading > p {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.68;
  }
  .split-heading {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .split-heading h2 {
    margin-bottom: 0;
  }
  .learning-cycle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30px minmax(0, 1fr) 30px minmax(0, 1fr) 30px minmax(0, 1fr);
    align-items: stretch;
  }
  .learning-cycle article {
    border-top: 4px solid #79aebb;
    background: #fff;
    padding: 1.2rem;
  }
  .learning-cycle article:nth-of-type(2) {
    border-color: #c38262;
  }
  .learning-cycle article:nth-of-type(3) {
    border-color: #4f8b84;
  }
  .learning-cycle article:nth-of-type(4) {
    border-color: #547894;
  }
  .learning-cycle article > span,
  .roles article > span {
    color: var(--orange);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .learning-cycle h3 {
    font-size: 1rem;
    line-height: 1.25;
    margin: 0.55rem 0;
  }
  .learning-cycle p {
    color: #586c78;
    font-size: 0.74rem;
    line-height: 1.55;
    margin: 0;
  }
  .learning-cycle > i {
    display: grid;
    place-items: center;
    width: 30px;
    color: var(--orange);
    font-style: normal;
    font-size: 1.25rem;
  }
  .preference-bridge {
    display: grid;
    grid-template-columns: auto 45px 1fr;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.2rem;
    border: 1px solid #b9d2d8;
    background: #e9f2f4;
    padding: 1rem 1.2rem;
  }
  .preference-bridge > div {
    display: grid;
  }
  .preference-bridge small {
    color: var(--blue);
    font-size: 0.59rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .preference-bridge strong {
    font-size: 0.82rem;
  }
  .preference-bridge > b {
    color: var(--orange);
    font-size: 1.5rem;
    text-align: center;
  }
  .preference-bridge p {
    color: #46616e;
    font-size: 0.77rem;
    line-height: 1.52;
    margin: 0;
  }
  .caption {
    color: #697b88;
    font-size: 0.72rem;
    line-height: 1.5;
    margin: 1rem 0 0;
  }
  .caption b {
    color: #2c4655;
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .roles article {
    border: 1px solid #d3e0e4;
    border-top: 4px solid #67a1af;
    background: #f8fafb;
    padding: 1.4rem;
  }
  .roles article:nth-child(2) {
    border-top-color: #bf7653;
  }
  .roles article:nth-child(3) {
    border-top-color: #759b8d;
  }
  .roles h3 {
    font-size: 1.25rem;
    margin: 0.55rem 0;
  }
  .roles ul {
    padding-left: 1rem;
    margin-bottom: 0;
  }
  .roles li {
    color: #526775;
    font-size: 0.78rem;
    line-height: 1.55;
    margin: 0.38rem 0;
  }
  .system {
    background: #eaf1f3;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: #516976;
    font-size: 0.71rem;
    margin-bottom: 1rem;
  }
  .key span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .key i {
    width: 1.6rem;
    border-top: 2px solid #3f8294;
  }
  .key i.proposed-line {
    border-top-style: dashed;
    border-color: #bc714b;
  }
  .architecture {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .arch-panel {
    min-width: 0;
    border: 1px solid #bdd0d6;
    background: #fff;
    padding: 1.35rem;
  }
  .arch-panel > header {
    border-bottom: 1px solid #d7e3e6;
    padding-bottom: 1rem;
    margin-bottom: 1.1rem;
  }
  .arch-panel > header span {
    color: var(--blue);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.14em;
  }
  .arch-panel > header h3 {
    font-size: 1.35rem;
    line-height: 1.26;
    letter-spacing: -0.03em;
    margin: 0.45rem 0 0;
  }
  .offline-paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .path {
    display: flex;
    flex-direction: column;
  }
  .node,
  .support-db {
    border: 1.5px solid #7faeb9;
    background: #f0f7f8;
    text-align: center;
    padding: 0.72rem;
  }
  .node.proposed,
  .support-db.proposed {
    border-color: #bd7650;
    border-style: dashed;
    background: #fff5ed;
  }
  .node small,
  .support-db small,
  .runtime-row aside small,
  .runtime-core small {
    display: block;
    color: #667d87;
    font-size: 0.54rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }
  .node strong,
  .support-db strong {
    display: block;
    color: #244b5c;
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .path > b,
  .runtime-start > b,
  .down {
    color: #3f8294;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1;
    padding: 0.22rem;
  }
  .path > b.orange,
  .lookup-arrow {
    color: #b76843;
  }
  .path > b.merge {
    min-height: 29px;
    font-size: 1.45rem;
  }
  .database {
    border: 2px solid #447d90;
    background: #e7f1f3;
    padding: 0.85rem;
  }
  .db-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #b7d1d7;
    padding-bottom: 0.55rem;
  }
  .db-head span {
    color: var(--blue);
    font-size: 0.61rem;
    font-weight: 950;
    letter-spacing: 0.14em;
  }
  .db-head strong {
    font-size: 0.67rem;
  }
  .db-records {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding-top: 0.65rem;
  }
  .db-records > div {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
  }
  .db-records .new {
    border-left: 1px dashed #bf7a56;
    padding-left: 0.7rem;
  }
  .db-records small {
    color: #4d7180;
    font-size: 0.53rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
  .db-records code {
    color: #385965;
    background: #fff9;
    font-size: 0.59rem;
    overflow-wrap: anywhere;
    padding: 0.16rem 0.25rem;
  }
  .runtime-start {
    width: 72%;
    margin: auto;
  }
  .runtime-row {
    display: grid;
    grid-template-columns: 0.8fr 28px 1.2fr;
    align-items: center;
    gap: 0.3rem;
    margin: 0.9rem 0;
  }
  .runtime-row aside {
    border: 1px solid #9fbec7;
    background: #eef6f7;
    padding: 0.65rem;
  }
  .runtime-row aside strong {
    display: block;
    color: #315968;
    font-size: 0.65rem;
  }
  .runtime-row aside p {
    color: #667b84;
    font-size: 0.56rem;
    line-height: 1.4;
    margin: 0.35rem 0 0;
  }
  .runtime-row > b {
    color: var(--orange);
    text-align: center;
  }
  .runtime-core {
    display: grid;
    text-align: center;
    border: 1.5px solid #679aaa;
    background: #e8f2f4;
    padding: 0.7rem;
  }
  .runtime-core strong {
    font-size: 0.72rem;
  }
  .runtime-core i {
    color: #568a98;
    font-style: normal;
    line-height: 1;
  }
  .lookup-arrow {
    text-align: center;
    font-size: 1.2rem;
    padding: 0.25rem;
  }
  .lookup-arrow small {
    font-size: 0.5rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .support-db > div {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.4rem;
  }
  .support-db span {
    color: #a46b50;
    font-size: 0.62rem;
  }
  .node.output {
    text-align: left;
  }
  .student-hint {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    border: 2px solid #3e7c8e;
    background: #dcecef;
    padding: 0.75rem;
    color: #204758;
  }
  .student-hint span {
    color: #57717d;
    font-size: 0.65rem;
  }
  .award {
    background: var(--dark);
    color: #fff;
  }
  .award-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .award h2 {
    color: #fff;
  }
  .award-grid p:last-child {
    color: #bed0d8;
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 720px;
  }
