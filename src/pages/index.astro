---
import { Font } from "astro:assets";
import DemoNavigator from "../components/DemoNavigator.astro";
import LearningLab from "../components/LearningLab.astro";
import "../styles/global.css";
import "../styles/mathbridge.css";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const live = "https://mathbridge-ai.duckdns.org/";
const projectRepo =
  "https://github.com/jovian-2wang/mathbridge-ai-project-page";
const appRepo = "https://github.com/jovian-2wang/mathbridge-AI";
const award = "https://www.nsf.gov/awardsearch/show-award/?AWD_ID=2627693";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MathBridge AI is a curriculum-grounded mathematics learning platform for students, teachers, and families."
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <title>MathBridge AI | Student-aware mathematics support</title>
  </head>

  <body class="project-page font-(family-name:--font-noto-sans)">
    <header id="top">
      <div class="nav shell">
        <a class="brand" href="#top">MathBridge <b>AI</b></a>
        <nav aria-label="Page navigation">
          <a href="#learning">How it helps</a><a href="#roles">Three views</a><a
            href="#demo">Live demo</a
          ><a href="#pipeline">Research pipeline</a>
        </nav>
      </div>

      <div class="affiliation-band">
        <div class="affiliations shell">
          <div>
            <span>LEAD ORGANIZATION</span><a
              href="https://www.utsa.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={`${base}brands/ut-san-antonio-logo.svg`}
                alt="The University of Texas at San Antonio"
              /></a
            >
          </div>
          <i aria-hidden="true"></i>
          <div class="uf">
            <span>SUB-AWARDEE ORGANIZATION</span><a
              href="https://www.ufl.edu/"
              target="_blank"
              rel="noopener noreferrer"
              ><img
                src={`${base}brands/uf-logo-full.png`}
                alt="University of Florida"
              /></a
            >
          </div>
          <a
            class="award-link"
            href={award}
            target="_blank"
            rel="noopener noreferrer">NSF Award #2627693 ↗</a
          >
        </div>
      </div>

      <div class="hero shell">
        <div class="hero-copy">
          <p class="overline">INTERACTIVE RESEARCH PROJECT</p>
          <h1>MathBridge AI</h1>
          <p class="subtitle">
            Help the student understand the next step—not just see the correct
            answer.
          </p>
          <p class="summary">
            The assigned Math 6 task stays at the center. MathBridge reads the
            student’s attempt, identifies the specific obstacle, and offers one
            targeted hint or visual so the student can try again. Language,
            interests, and read-aloud preferences make that help easier to
            access without changing the mathematics.
          </p>
          <div class="actions">
            <a class="primary" href="#demo">Explore the live demo</a><a
              href={live}
              target="_blank"
              rel="noopener noreferrer">Open platform ↗</a
            ><a href={projectRepo} target="_blank" rel="noopener noreferrer"
              >Project code ↗</a
            ><a href={award} target="_blank" rel="noopener noreferrer"
              >NSF award ↗</a
            >
          </div>
          <p class="private-repo">
            Application source: <a
              href={appRepo}
              target="_blank"
              rel="noopener noreferrer">private repository ↗</a
            >
          </p>
        </div>

        <aside
          class="hero-example"
          aria-label="Example of student-aware support"
        >
          <div class="task-tag">MATH 6 · UNIT RATE</div>
          <p class="question">
            24 points in 3 games at the same rate. How many points per game?
          </p>
          <div class="attempt">
            <span>STUDENT ATTEMPT</span><strong>6 points per game</strong>
          </div>
          <div class="diagnosis">
            <span>WHAT THE SYSTEM NOTICES</span><strong
              >The student divided, but the rate does not scale back to 24.</strong
            >
          </div>
          <div class="next-step">
            <span>NEXT-STEP HINT</span><strong
              >“Three equal groups make 24. What number times 3 makes 24?”</strong
            >
          </div>
          <div class="retry">Hint → retry → similar problem</div>
        </aside>
      </div>
    </header>

    <main>
      <section id="learning" class="section pale">
        <div class="shell">
          <div class="section-head">
            <p class="overline">01 / HOW THE STUDENT IS SUPPORTED</p><h2>
              From the course task to another attempt.
            </h2>
          </div>
          <div class="core-loop">
            <article class="primary-step">
              <span>1</span><div>
                <small>PRIMARY</small><h3>Math 6 course task</h3>
              </div>
            </article>
            <b aria-hidden="true">→</b>
            <article>
              <span>2</span><div>
                <small>EVIDENCE</small><h3>Student attempt</h3>
              </div>
            </article>
            <b aria-hidden="true">→</b>
            <article>
              <span>3</span><div>
                <small>DIAGNOSIS</small><h3>Find the obstacle</h3>
              </div>
            </article>
            <b aria-hidden="true">→</b>
            <article>
              <span>4</span><div>
                <small>NEXT MOVE</small><h3>One focused hint</h3>
              </div>
            </article>
            <b aria-hidden="true">→</b>
            <article class="retry-step">
              <span>5</span><div>
                <small>ACTIVE LEARNING</small><h3>Retry + similar problem</h3>
              </div>
            </article>
          </div>
          <p class="loop-explanation">
            <b>The course remains primary.</b> The original prompt, numbers, relationship,
            and target skill stay fixed. The student’s response determines the next
            hint; the hint supports another attempt without revealing the answer.
          </p>

          <div class="preference-title">
            <p class="overline">STUDENT PREFERENCES HAVE SPECIFIC JOBS</p><h3>
              Preferences change access—not the learning goal.
            </h3>
          </div>
          <div class="preference-grid">
            <article>
              <span>INTEREST</span><h4>
                Make the explanation easier to enter.
              </h4><p>
                If a student chooses basketball, a hint may use a familiar
                basketball analogy to explain equal rates. The assigned
                question, numbers, and correct answer do not change.
              </p><div>
                <b>Basketball analogy</b><em>→ same ratio relationship</em>
              </div>
            </article>
            <article>
              <span>BILINGUAL SUPPORT</span><h4>
                Clarify language without replacing English.
              </h4><p>
                The English task remains visible. A short Chinese or Spanish
                explanation clarifies vocabulary and directions so language does
                not hide the mathematics.
              </p><div>
                <b>“unit rate” + 单位率</b><em>→ same mathematical term</em>
              </div>
            </article>
            <article>
              <span>READ-ALOUD</span><h4>Reduce the reading barrier.</h4><p>
                The student can listen to the prompt or hint. Audio provides
                another way to access the words; it does not solve the problem.
              </p><div>
                <b>Listen to prompt</b><em>→ student still reasons</em>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="roles" class="section">
        <div class="shell">
          <div class="section-head">
            <p class="overline">
              02 / THE SAME EVIDENCE, THREE USEFUL OUTCOMES
            </p><h2>Each view answers one practical question.</h2>
          </div>
          <div class="role-grid">
            <article>
              <div class="role-name">STUDENT</div><h3>
                “What should I try next?”
              </h3><div class="role-flow">
                <span>My attempt</span><b>→</b><span>One focused hint</span><b
                  >→</b
                ><span>Try again</span>
              </div><p>
                The student receives enough support to continue thinking, then
                practices the same idea in another problem.
              </p><strong class="benefit"
                >Benefit: progress without immediately revealing the answer.</strong
              >
            </article>
            <article>
              <div class="role-name">TEACHER</div><h3>
                “What should I teach next?”
              </h3><div class="role-flow">
                <span>Class attempts</span><b>→</b><span
                  >Repeated misconception</span
                ><b>→</b><span>Next mini-lesson</span>
              </div><p>
                The dashboard turns separate answers into patterns by skill,
                misconception, and recent evidence.
              </p><strong class="benefit"
                >Benefit: the teacher can group students and choose a targeted
                follow-up.</strong
              >
            </article>
            <article>
              <div class="role-name">FAMILY</div><h3>
                “How can I help tonight?”
              </h3><div class="role-flow">
                <span>Simple summary</span><b>→</b><span
                  >One question to ask</span
                ><b>→</b><span>Short practice</span>
              </div><p>
                The parent sees where the child is stuck without reading a
                technical teacher dashboard.
              </p><strong class="benefit"
                >Benefit: a focused 10-minute conversation instead of more
                unstructured homework.</strong
              >
            </article>
          </div>
        </div>
      </section>

      <section id="demo" class="section demo-section">
        <div class="shell">
          <div class="split-head">
            <div>
              <p class="overline">03 / LIVE PLATFORM</p><h2>
                See the student, teacher, and parent views.
              </h2>
            </div><p>
              This is the running MathBridge AI application. Choose a role to
              see what to examine, then open the platform in the embedded window
              or a new tab.
            </p>
          </div>
          <DemoNavigator />
        </div>
      </section>

      <section class="section preference-demo">
        <div class="shell">
          <div class="split-head">
            <div>
              <p class="overline">04 / TRY THE PREFERENCE LOGIC</p><h2>
                Change the presentation, not the mathematics.
              </h2>
            </div><p>
              Choose a language, interest, or reading option. The context and
              access method change while the division relationship stays fixed.
            </p>
          </div>
          <LearningLab />
        </div>
      </section>

      <section id="pipeline" class="section pipeline-section">
        <div class="shell">
          <div class="section-head">
            <p class="overline">05 / RESEARCH PIPELINE</p><h2>
              The course is primary. Correct answers and solution explanations
              are auxiliary.
            </h2><p>
              The offline process prepares safe materials before students use
              the system. The online process begins with the assigned course
              task and the student’s own response.
            </p>
          </div>

          <div class="pipeline-stack">
            <section class="pipeline-block">
              <header>
                <span>OFFLINE · PREPARE THE COURSE</span><h3>
                  Student Edition is the course. Answer Edition is auxiliary.
                </h3>
              </header>
              <div class="primary-route">
                <div>
                  <small>PRIMARY SOURCE</small><strong
                    >Math 6 Student Edition</strong>
                </div><b>→</b><div>
                  <small>COURSE RECORD</small><strong
                    >Task + target skill</strong>
                </div><b>→</b><div class="database-box">
                  <small>SUPABASE</small><strong
                    >Assigned course content</strong>
                </div>
              </div>
              <div class="aux-route">
                <span>AUXILIARY</span><div>
                  <small>Math 6 Answer Edition</small><strong
                    >Correct answer + solution</strong>
                </div><b>→</b><div>
                  <small>Extract + check</small><strong
                    >Verified explanation</strong>
                </div><b>↗</b>
              </div>
              <p class="pipeline-note">
                The correct answer helps verify explanatory material. It does
                not replace the Student Edition task and is not shown to the
                student as a hint.
              </p>
            </section>

            <section class="pipeline-block">
              <header>
                <span>ONLINE · SUPPORT THE STUDENT</span><h3>
                  The student’s attempt decides what happens next.
                </h3>
              </header>
              <div class="runtime-route">
                <div><small>COURSE</small><strong>Math 6 task</strong></div><b
                  >→</b
                ><div><small>STUDENT</small><strong>Attempt</strong></div><b
                  >→</b
                ><div>
                  <small>SYSTEM</small><strong>Validate + diagnose</strong>
                </div><b>→</b><div class="help-box">
                  <small>IF HELP IS NEEDED</small><strong
                    >One verified hint or visual</strong>
                </div><b>→</b><div class="retry-box">
                  <small>STUDENT</small><strong>Retry</strong>
                </div>
              </div>
              <div class="preference-strip">
                <span>PREFERENCE SHAPES THE HINT</span><b>Interest:</b> familiar analogy
                <i>·</i><b>Bilingual:</b> clarify terms <i>·</i><b
                  >Read-aloud:</b
                > speak the hint
              </div>
              <p class="pipeline-note">
                Preferences change how the next step is communicated. They never
                change the task, target skill, or correct mathematics.
              </p>
            </section>
          </div>

          <p class="status-note">
            <b>Prototype status:</b> Course tasks, micro-skills, validator, diagnosis,
            Hint Agent, hints, evidence, and visuals describe the current platform.
            Importing and automatically evaluating Answer Edition explanation materials
            is the proposed research extension.
          </p>
        </div>
      </section>

      <section class="award-section section">
        <div class="shell award-grid">
          <div>
            <p class="overline">RESEARCH CONTEXT</p><h2>
              NSF Award #2627693
            </h2><p>
              MathBridge AI is presented as an academic research prototype
              involving UT San Antonio and the University of Florida.
            </p>
          </div><a href={award} target="_blank" rel="noopener noreferrer"
            >View the official award record ↗</a
          >
        </div>
      </section>
    </main>

    <footer>
      <div class="shell">
        <strong>MathBridge AI</strong><span
          >Student-aware mathematics support</span
        ><a href={projectRepo} target="_blank" rel="noopener noreferrer"
          >GitHub project page ↗</a
        >
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #173244;
    --muted: #526a79;
    --blue: #17667a;
    --blue2: #2c7f92;
    --orange: #b65d3b;
    --line: #d4e1e5;
    --pale: #f3f7f8;
    --dark: #173d50;
  }
  .project-page {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-noto-sans), Arial, sans-serif;
  }
  .project-page * {
    box-sizing: border-box;
  }
  .project-page :is(h1, h2, h3, h4, p, dl, dd, ul) {
    margin-block-start: 0;
  }
  .project-page :is(a, button, input):focus-visible {
    outline: 3px solid #ef9f43;
    outline-offset: 3px;
  }
  .shell {
    width: min(1360px, calc(100% - 3rem));
    margin-inline: auto;
  }
  .nav {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    color: var(--ink) !important;
    font-size: 1rem;
    font-weight: 900 !important;
    text-decoration: none !important;
  }
  .brand b {
    color: var(--orange);
  }
  .nav nav {
    display: flex;
    gap: clamp(0.8rem, 2.4vw, 1.8rem);
  }
  .nav nav a {
    color: #526775 !important;
    font-size: 0.76rem;
    font-weight: 750 !important;
    text-decoration: none !important;
  }
  .affiliation-band {
    background: var(--dark);
  }
  .affiliations {
    min-height: 106px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .affiliations > div {
    display: grid;
    gap: 0.5rem;
  }
  .affiliations span {
    color: #b6cbd3;
    font-size: 0.59rem;
    font-weight: 850;
    letter-spacing: 0.14em;
  }
  .affiliations img {
    display: block;
    width: auto;
    max-width: 220px;
    max-height: 42px;
    margin: 0;
    filter: brightness(0) invert(1);
  }
  .affiliations .uf img {
    max-width: 230px;
    max-height: 47px;
    filter: none;
  }
  .affiliations > i {
    height: 55px;
    border-left: 1px solid #587688;
  }
  .award-link {
    margin-left: auto;
    color: #fff !important;
    border: 1px solid #6b8796;
    padding: 0.7rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding: 5.2rem 0;
  }
  .overline {
    color: var(--orange);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    line-height: 1.4;
    margin-bottom: 0.8rem;
  }
  .hero h1 {
    font-size: clamp(4.1rem, 7.5vw, 6.7rem);
    line-height: 0.96;
    letter-spacing: -0.065em;
    font-weight: 780;
    margin: 0 0 1rem;
  }
  .subtitle {
    color: #254f64;
    font:
      400 clamp(1.35rem, 2.4vw, 1.9rem)/1.28 Georgia,
      serif;
    max-width: 700px;
    margin-bottom: 1rem;
  }
  .summary {
    color: #496171;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 720px;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    color: var(--dark) !important;
    border: 1px solid #b9cbd2;
    padding: 0.58rem 0.82rem;
    font-size: 0.73rem;
    font-weight: 800 !important;
    text-decoration: none !important;
  }
  .actions .primary {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff !important;
  }
  .private-repo {
    color: #74838c;
    font-size: 0.68rem;
    margin: 0.8rem 0 0;
  }
  .hero-example {
    border: 1px solid #b9cfd6;
    background: #f8fbfb;
    box-shadow: 16px 16px 0 #e7eef0;
    padding: 1.4rem;
  }
  .task-tag {
    color: var(--blue);
    font-size: 0.61rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    border-bottom: 1px solid #d6e3e6;
    padding-bottom: 0.7rem;
  }
  .question {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 760;
    line-height: 1.42;
    margin: 1rem 0;
  }
  .attempt,
  .diagnosis,
  .next-step {
    display: grid;
    gap: 0.18rem;
    padding: 0.7rem 0.8rem;
    margin-top: 0.55rem;
  }
  .attempt {
    background: #fff1ea;
    border-left: 3px solid var(--orange);
  }
  .diagnosis {
    background: #edf4f6;
    border-left: 3px solid #78aeba;
  }
  .next-step {
    background: #e6f1ee;
    border-left: 3px solid #4e8d7e;
  }
  .hero-example span {
    color: #617987;
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
  .hero-example strong {
    color: #294a59;
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .retry {
    margin-top: 0.8rem;
    text-align: center;
    color: var(--blue);
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }
  .section {
    padding: 4.8rem 0;
  }
  .pale {
    background: var(--pale);
  }
  .section-head {
    max-width: 860px;
    margin-bottom: 1.8rem;
  }
  .section-head h2,
  .split-head h2,
  .award-grid h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.14;
    letter-spacing: -0.047em;
    font-weight: 740;
    margin: 0 0 0.8rem;
  }
  .section-head > p:last-child,
  .split-head > p {
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.65;
  }
  .core-loop {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) 28px minmax(0, 1fr) 28px minmax(
        0,
        1fr
      ) 28px minmax(0, 1fr) 28px minmax(0, 1.15fr);
    align-items: stretch;
  }
  .core-loop article {
    display: flex;
    gap: 0.8rem;
    border: 1px solid #d2e0e4;
    background: #fff;
    padding: 1.1rem;
  }
  .core-loop article.primary-step {
    border: 2px solid #4f91a1;
    background: #eaf4f6;
  }
  .core-loop article > span {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #e7f0f2;
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 900;
  }
  .core-loop .primary-step > span {
    background: var(--blue);
    color: #fff;
  }
  .core-loop small {
    color: #6d8089;
    font-size: 0.53rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }
  .core-loop h3 {
    font-size: 1.04rem;
    line-height: 1.25;
    margin: 0.35rem 0;
  }
  .core-loop > b {
    display: grid;
    place-items: center;
    width: 30px;
    color: var(--orange);
    font-size: 1.25rem;
  }
  .core-loop .retry-step {
    border-color: #74a08f;
    background: #edf5f1;
  }
  .loop-explanation {
    max-width: 980px;
    color: #536a76;
    font-size: 0.78rem;
    line-height: 1.6;
    margin: 0.9rem 0 0;
  }
  .loop-explanation b {
    color: #28586a;
  }
  .preference-title {
    margin: 2.6rem 0 1rem;
  }
  .preference-title h3 {
    font-size: 1.7rem;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .preference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .preference-grid article {
    border-top: 4px solid #69a2b0;
    background: #fff;
    padding: 1.25rem;
  }
  .preference-grid article:nth-child(2) {
    border-color: #c17a57;
  }
  .preference-grid article:nth-child(3) {
    border-color: #6c9788;
  }
  .preference-grid article > span {
    color: var(--blue);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .preference-grid h4 {
    font-size: 1.1rem;
    line-height: 1.3;
    margin: 0.55rem 0;
